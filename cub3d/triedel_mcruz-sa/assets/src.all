/// game struct, containing complete game state and assets
typedef struct s_game
{
	t_display		disp;
	// game state
	t_gamestate		state;
	unsigned int	ticks;
	t_vec3			pos;
	float			mz;
	float			rot;
	float			rotx;
	float			health;
	bool			damage_taken;
	// game objects
	t_obj			objects[MAX_OBJECTS];
	// input
	unsigned char	input_state[INPUT_STATE_SIZE];
	// map
	t_map			map;
	//minimap
	t_rect			minimap_rect;
	t_ipt			minimap_center;
	// graphics
	float			fov;
	float			fstop;
	float			cam_width;
	float			cam_height;
	int				upscale;
	struct timeval	last_draw;
	int				fps;
	// textures
	t_img			*textures;
	// matrix mode
	int				matrix_mode;
	float			matrix_mode_mix;
	t_mattex		mt;
	t_img			mattex;
	// toggleables
	bool			physics;
	bool			show_minimap;
	bool			show_debug;
	// multi-threaded rendering
	t_column_data	*hit_buffer;
	pthread_mutex_t	mutex_render;
	int				next_col;
